# Copy this file to backend/.env and add your own keys.
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite

# Optional: required only for speaker identification.
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

SONICBRIEF_HOST=127.0.0.1
SONICBRIEF_PORT=7860
MAX_UPLOAD_MB=500
MAX_MEDIA_HOURS=3
GEMINI_FALLBACK_LOGPROB=-1.2
