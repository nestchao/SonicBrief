# Optional advanced configuration. You can enter your Gemini key and choose
# the model from SonicBrief > Gemini Settings instead of editing this file.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Legacy per-task overrides remain supported. Gemini Settings keeps these in
# sync with GEMINI_MODEL when you save a model from the app.
# GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash
# GEMINI_SUMMARY_MODEL=gemini-3.8-flash

# Optional speaker identification.
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

SONICBRIEF_HOST=127.0.0.1
SONICBRIEF_PORT=7860
MAX_UPLOAD_MB=500
MAX_MEDIA_HOURS=12
GEMINI_FALLBACK_LOGPROB=-1.2
