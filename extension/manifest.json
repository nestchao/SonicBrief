{
  "manifest_version": 3,
  "name": "SonicBrief",
  "version": "0.1.1",
  "description": "Send the video you are watching to your local SonicBrief app for transcription and summaries.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Transcribe with SonicBrief",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "contextMenus", "storage", "notifications", "alarms"],
  "host_permissions": ["http://127.0.0.1:7860/*", "http://127.0.0.1:3000/*"],
  "commands": {
    "transcribe-current-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Transcribe the current tab with SonicBrief"
    }
  }
}
